{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism",
  "version": "0.1.0",
  "identifier": "com.prism.app",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [{
      "title": "Prism",
      "width": 1280,
      "height": 800,
      "minWidth": 760,
      "minHeight": 560,
      "center": true,
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "SocialNetworking",
    "shortDescription": "Prism chat",
    "longDescription": "Prism desktop chat application."
  }
}